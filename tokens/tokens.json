{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Express Employment Professionals ANZ. Primary and secondary colours are the published values from the Express Employment Professionals Brand Guide (revised June 2026). Web-layer neutrals, hover states and container widths are the values actually shipping on expresspros.com.au and expressfranchising.com.au. Anything derived for accessibility lives under palette.accessible and is labelled as such.",
  "$modes": ["franchise"],

  "palette": {
    "blue": {
      "light": {
        "$type": "color",
        "$value": "#0096D6",
        "$description": "PMS 2925. Impressive, vibrant, trusting, open. The lightest blue in the logo and the blue used in every brand gradient."
      },
      "medium": {
        "$type": "color",
        "$value": "#0077C0",
        "$description": "PMS 2935. Faithful, true, constant, dependable. The tagline colour and the web link colour."
      },
      "deep": {
        "$type": "color",
        "$value": "#005288",
        "$description": "PMS 2955. Credible, classic, strong, professional, confident. The single-colour logo option and the primary action colour."
      },
      "deep-hover": {
        "$type": "color",
        "$value": "#003E66",
        "$description": "Deep blue pressed/hover state. Shipping on expresspros.com.au."
      },
      "deepest": {
        "$type": "color",
        "$value": "#002944",
        "$description": "Darkest blue ground, for full-bleed inverse sections. Shipping on expresspros.com.au."
      },
      "tint": {
        "$type": "color",
        "$value": "#99D5EF",
        "$description": "Derived. Light blue mixed 60% into white so it clears 4.5:1 on deep blue. The only safe muted text colour on a deep blue ground, and not safe on medium blue, where nothing but white is."
      },
      "tint-light": {
        "$type": "color",
        "$value": "#D9EFF9",
        "$description": "Derived. Light blue mixed 85% into white, so it clears the 3:1 non-text threshold on medium blue as well as deep blue. Rules and borders on any inverse ground."
      }
    },

    "grey": {
      "base": {
        "$type": "color",
        "$value": "#53565A",
        "$description": "Brand secondary grey. The brand guide names this the body copy colour."
      }
    },

    "green": {
      "base": {
        "$type": "color",
        "$value": "#5A9F51",
        "$description": "Brand secondary. Accent and gradient use only, and never used in the logo."
      }
    },
    "purple": {
      "base": {
        "$type": "color",
        "$value": "#7E2B8A",
        "$description": "Brand secondary. Accent and gradient use only, and never used in the logo."
      },
      "franchise": {
        "$type": "color",
        "$value": "#6B1778",
        "$description": "The deeper purple shipping as the CTA colour on expressfranchising.com.au."
      }
    },
    "orange": {
      "base": {
        "$type": "color",
        "$value": "#D5672C",
        "$description": "Brand secondary. Accent and gradient use only, and never used in the logo."
      }
    },
    "red": {
      "base": {
        "$type": "color",
        "$value": "#C6222B",
        "$description": "Brand secondary. Also the Express Healthcare Staffing accent."
      }
    },
    "yellow": {
      "base": {
        "$type": "color",
        "$value": "#E9B632",
        "$description": "Brand secondary. 1.87:1 on white, so it is a fill colour carrying dark ink, never a text or line colour on a light ground."
      }
    },

    "neutral": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "50": { "$type": "color", "$value": "#F4F4F4", "$description": "Section tint on expresspros.com.au." },
      "100": { "$type": "color", "$value": "#EAEAEA", "$description": "Hairline rules and dividers." },
      "200": { "$type": "color", "$value": "#CACACA", "$description": "Input borders." },
      "400": { "$type": "color", "$value": "#959595", "$description": "Disabled text and icons. 3.00:1 on white, so non-text only." },
      "black": { "$type": "color", "$value": "#000000" }
    },

    "accessible": {
      "$description": "Derived, not brand-guide colours. The lightest shade of each secondary that clears 4.5:1 on both white and the #F4F4F4 tint, so status text and gold accents can be read.",
      "green": { "$type": "color", "$value": "#467C3F", "$description": "4.98:1 on white, 4.53:1 on #F4F4F4." },
      "orange": { "$type": "color", "$value": "#B35524", "$description": "4.95:1 on white, 4.50:1 on #F4F4F4." },
      "gold": { "$type": "color", "$value": "#8E6A0F", "$description": "4.98:1 on white, 4.53:1 on #F4F4F4. Text-grade stand-in for brand yellow." }
    },

    "gradient": {
      "$description": "The four approved pairings, and only these four. The brand guide runs them vertically down a page edge; the -h variants are the same pairings turned 90 degrees for rules and banners.",
      "green-blue": { "$type": "gradient", "$value": "linear-gradient(180deg, #5A9F51 0%, #0096D6 100%)" },
      "blue-purple": { "$type": "gradient", "$value": "linear-gradient(180deg, #0096D6 0%, #7E2B8A 100%)" },
      "purple-orange": { "$type": "gradient", "$value": "linear-gradient(180deg, #7E2B8A 0%, #D5672C 100%)" },
      "red-yellow": { "$type": "gradient", "$value": "linear-gradient(180deg, #C6222B 0%, #E9B632 100%)" },
      "green-blue-h": { "$type": "gradient", "$value": "linear-gradient(90deg, #5A9F51 0%, #0096D6 100%)" },
      "blue-purple-h": { "$type": "gradient", "$value": "linear-gradient(90deg, #0096D6 0%, #7E2B8A 100%)" },
      "purple-orange-h": { "$type": "gradient", "$value": "linear-gradient(90deg, #7E2B8A 0%, #D5672C 100%)" },
      "red-yellow-h": { "$type": "gradient", "$value": "linear-gradient(90deg, #C6222B 0%, #E9B632 100%)" }
    },

    "overlay": {
      "$description": "Photograph overlays. Express never runs a hero photograph bare, because white headline type has no checkable contrast against an image. These three are the treatments on expresspros.com.au: blue for job seekers, purple for employers, deep for a neutral or franchise hero.",
      "blue": { "$type": "gradient", "$value": "linear-gradient(90deg, rgb(0 82 136 / 0.92) 0%, rgb(0 150 214 / 0.72) 100%)" },
      "purple": { "$type": "gradient", "$value": "linear-gradient(90deg, rgb(126 43 138 / 0.92) 0%, rgb(198 34 43 / 0.72) 100%)" },
      "deep": { "$type": "gradient", "$value": "linear-gradient(90deg, rgb(0 41 68 / 0.94) 0%, rgb(0 82 136 / 0.78) 100%)" }
    }
  },

  "brand": {
    "logo": {
      "clear-space-ratio": {
        "$type": "number",
        "$value": "0.45",
        "$description": "Clear space on all four sides, as a fraction of the lock-up height. The brand guide states it as the top half of the stylised X; measured off the guide's own grid on page 12 that is 45% of the lock-up height."
      }
    },

    "bg": {
      "default": { "$type": "color", "$value": "{palette.neutral.white}" },
      "subtle": { "$type": "color", "$value": "{palette.neutral.50}" },
      "inverse": { "$type": "color", "$value": "{palette.blue.deep}" },
      "inverse-strong": { "$type": "color", "$value": "{palette.blue.deepest}" },
      "brand": { "$type": "color", "$value": "{palette.blue.medium}" }
    },

    "text": {
      "primary": { "$type": "color", "$value": "{palette.grey.base}" },
      "heading": { "$type": "color", "$value": "{palette.blue.deep}" },
      "muted": { "$type": "color", "$value": "{palette.grey.base}" },
      "inverse": { "$type": "color", "$value": "{palette.neutral.white}" },
      "inverse-muted": { "$type": "color", "$value": "{palette.blue.tint}" },
      "link": { "$type": "color", "$value": "{palette.blue.medium}" },
      "link-hover": { "$type": "color", "$value": "{palette.blue.deep}" },
      "on-highlight": { "$type": "color", "$value": "{palette.neutral.black}" }
    },

    "border": {
      "subtle": { "$type": "color", "$value": "{palette.neutral.100}" },
      "default": { "$type": "color", "$value": "{palette.neutral.200}" },
      "strong": { "$type": "color", "$value": "{palette.neutral.400}" },
      "inverse": { "$type": "color", "$value": "{palette.blue.tint-light}" }
    },

    "action": {
      "primary-bg": { "$type": "color", "$value": "{palette.blue.deep}" },
      "primary-bg-hover": { "$type": "color", "$value": "{palette.blue.deep-hover}" },
      "primary-fg": { "$type": "color", "$value": "{palette.neutral.white}" },
      "primary-fg-hover": { "$type": "color", "$value": "{palette.neutral.white}" },
      "secondary-bg": { "$type": "color", "$value": "{palette.neutral.white}" },
      "secondary-fg": { "$type": "color", "$value": "{palette.blue.deep}" },
      "secondary-border": { "$type": "color", "$value": "{palette.blue.deep}" },
      "accent-bg": { "$type": "color", "$value": "{palette.purple.base}" },
      "accent-fg": { "$type": "color", "$value": "{palette.neutral.white}" },
      "ghost-fg": { "$type": "color", "$value": "{palette.blue.medium}" },
      "disabled-bg": { "$type": "color", "$value": "{palette.neutral.100}" },
      "disabled-fg": { "$type": "color", "$value": "{palette.neutral.400}" }
    },

    "focus": {
      "ring": { "$type": "color", "$value": "{palette.blue.medium}" },
      "ring-inverse": { "$type": "color", "$value": "{palette.neutral.white}" }
    },

    "status": {
      "success": { "$type": "color", "$value": "{palette.accessible.green}" },
      "success-fill": { "$type": "color", "$value": "{palette.green.base}" },
      "warning": { "$type": "color", "$value": "{palette.accessible.orange}" },
      "warning-fill": { "$type": "color", "$value": "{palette.orange.base}" },
      "danger": { "$type": "color", "$value": "{palette.red.base}" },
      "info": { "$type": "color", "$value": "{palette.blue.medium}" },
      "highlight": { "$type": "color", "$value": "{palette.yellow.base}" },
      "highlight-text": { "$type": "color", "$value": "{palette.accessible.gold}" }
    },

    "type": {
      "heading-family": { "$type": "fontFamily", "$value": "{type.sans}" },
      "heading-weight": { "$type": "fontWeight", "$value": "700" },
      "heading-case": { "$type": "other", "$value": "none" },
      "subheading-case": { "$type": "other", "$value": "none" },
      "heading-tracking": { "$type": "dimension", "$value": "0" },
      "body-family": { "$type": "fontFamily", "$value": "{type.sans}" },
      "body-weight": { "$type": "fontWeight", "$value": "300" },
      "h1-size": { "$type": "dimension", "$value": "3rem" },
      "h1-leading": { "$type": "number", "$value": "1.0833" },
      "h2-size": { "$type": "dimension", "$value": "2.25rem" },
      "h2-leading": { "$type": "number", "$value": "1.4444" },
      "h3-size": { "$type": "dimension", "$value": "2rem" },
      "h3-leading": { "$type": "number", "$value": "1.625" },
      "body-size": { "$type": "dimension", "$value": "1rem" },
      "body-leading": { "$type": "number", "$value": "1.625" },
      "container": { "$type": "dimension", "$value": "1200px" },
      "radius": { "$type": "dimension", "$value": "{radius.default}" }
    },

    "franchise": {
      "$description": "The franchise-recruitment register, as shipping on expressfranchising.com.au. Set data-brand-mode=\"franchise\" on a root element to switch to it. Louder, condensed, uppercase, purple CTAs. Use it for franchise-owner recruitment only, never mixed into staffing or job-seeker material.",
      "bg": {
        "inverse": { "$type": "color", "$value": "{palette.blue.medium}" },
        "subtle": { "$type": "color", "$value": "#F1F1F1" }
      },
      "text": {
        "inverse-muted": {
          "$type": "color",
          "$value": "{palette.neutral.white}",
          "$description": "There is no muted text tier on a medium blue ground. White itself only reaches 4.77:1 there, so any tint fails. Muted resolves to white; if a block genuinely needs two text tiers, move it to a deep blue ground."
        }
      },
      "action": {
        "primary-bg": { "$type": "color", "$value": "{palette.purple.franchise}" },
        "primary-bg-hover": { "$type": "color", "$value": "{palette.neutral.white}" },
        "primary-fg-hover": { "$type": "color", "$value": "{palette.purple.franchise}" },
        "accent-bg": { "$type": "color", "$value": "{palette.purple.franchise}" }
      },
      "type": {
        "heading-family": { "$type": "fontFamily", "$value": "{type.display}" },
        "heading-case": { "$type": "other", "$value": "uppercase" },
        "body-weight": { "$type": "fontWeight", "$value": "400" },
        "h1-size": { "$type": "dimension", "$value": "3.75rem" },
        "h1-leading": { "$type": "number", "$value": "1" },
        "h2-size": { "$type": "dimension", "$value": "2.2rem" },
        "h2-leading": { "$type": "number", "$value": "1.2" },
        "h3-size": { "$type": "dimension", "$value": "1.5rem" },
        "h3-leading": { "$type": "number", "$value": "1.2" },
        "body-size": { "$type": "dimension", "$value": "1.3rem" },
        "body-leading": { "$type": "number", "$value": "1.5" },
        "container": { "$type": "dimension", "$value": "1400px" },
        "radius": { "$type": "dimension", "$value": "{radius.sm}" }
      }
    }
  },

  "type": {
    "sans": {
      "$type": "fontFamily",
      "$value": "Roboto",
      "$description": "The Express web typeface. Weights vendored: 300, 400, 500, 700, plus 300/400/700 italic."
    },
    "display": {
      "$type": "fontFamily",
      "$value": "Roboto Condensed",
      "$description": "Franchise-register headings. Weights vendored: 400, 700."
    },
    "print": {
      "$type": "fontFamily",
      "$value": "Proxima Nova",
      "$description": "The Express print and collateral typeface. Licensed from Mark Simonson Studio and NOT vendored here. See LICENSE."
    },
    "tagline": {
      "$type": "fontFamily",
      "$value": "Myriad Pro",
      "$description": "The tagline lock-up is set in Myriad Pro Roman. Adobe-licensed and NOT vendored. See LICENSE."
    },
    "baseline": {
      "$type": "dimension",
      "$value": "26px",
      "$description": "Every heading and body line-height on expresspros.com.au resolves to 26px or 52px. Keep vertical rhythm on this grid."
    },
    "weight": {
      "light": { "$type": "fontWeight", "$value": "300" },
      "regular": { "$type": "fontWeight", "$value": "400" },
      "medium": { "$type": "fontWeight", "$value": "500" },
      "bold": { "$type": "fontWeight", "$value": "700" }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.25rem" },
      "xl": { "$type": "dimension", "$value": "1.5rem" },
      "2xl": { "$type": "dimension", "$value": "2rem" },
      "3xl": { "$type": "dimension", "$value": "2.25rem" },
      "4xl": { "$type": "dimension", "$value": "3rem" },
      "5xl": { "$type": "dimension", "$value": "3.75rem" }
    }
  },

  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "baseline": { "$type": "dimension", "$value": "1.625rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "20": { "$type": "dimension", "$value": "5rem" },
    "24": { "$type": "dimension", "$value": "6rem" }
  },

  "radius": {
    "none": { "$type": "dimension", "$value": "0" },
    "sm": { "$type": "dimension", "$value": "5px" },
    "default": { "$type": "dimension", "$value": "9px" },
    "lg": { "$type": "dimension", "$value": "20px" },
    "pill": { "$type": "dimension", "$value": "999px" },
    "circle": { "$type": "dimension", "$value": "50%" }
  },

  "shadow": {
    "card": { "$type": "shadow", "$value": "0 1px 3px rgb(0 41 68 / 0.12)" },
    "raised": { "$type": "shadow", "$value": "0 8px 24px rgb(0 41 68 / 0.16)" }
  }
}
